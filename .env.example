# ─── 사이트 URL ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tetolab.com

# ─── Google Analytics ───────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Google AdSense ─────────────────────────────────────
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
# 아래 슬롯 ID는 AdSense 계정 승인 후 생성된 광고 단위 ID로 교체하세요
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# ─── Kakao SDK ──────────────────────────────────────────
NEXT_PUBLIC_KAKAO_KEY=

# ─── Redis (선택, 미설정 시 인메모리 폴백) ──────────────
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
